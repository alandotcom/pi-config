{
  "name": "@alandotcom/pi-config",
  "version": "0.2.2",
  "description": "An opinionated, shareable Pi coding-agent profile with extensions, skills, and reproducible setup.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts test/*.test.mjs",
    "doctor": "node scripts/doctor.mjs"
  },
  "pi": {
    "extensions": [
      "./extensions/ask-async.ts",
      "./extensions/recall.ts",
      "./extensions/btw/index.ts",
      "./extensions/btw/session-fork.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "extensions",
    "skills",
    "profile",
    "scripts",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "typebox": "^1.3.27"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alandotcom/pi-config.git"
  },
  "homepage": "https://github.com/alandotcom/pi-config#readme",
  "bugs": "https://github.com/alandotcom/pi-config/issues",
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
